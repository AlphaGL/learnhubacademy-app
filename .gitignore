# Flutter / Dart
.dart_tool/
.packages
build/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
*.iml
.idea/
.vscode/

# Secrets — never commit these
# (google-services.json is intentionally NOT listed here — its contents ship
# inside the compiled APK anyway, so Google doesn't treat it as secret, and
# GitHub Actions needs it in the checkout to build. See docs/R2_HOSTING.md.)
**/GoogleService-Info.plist
android/key.properties
*.keystore
*.jks
lib/core/config/secrets.dart
.env
dart_define.json

# Android
android/.gradle/
android/.kotlin/
android/local.properties
android/app/debug/
android/app/profile/
android/app/release/

# iOS
ios/Pods/
ios/.symlinks/
ios/Flutter/Flutter.framework
ios/Flutter/Flutter.podspec

# Misc
*.log
